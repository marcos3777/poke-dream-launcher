{
  "name": "poke-dream-launcher",
  "version": "1.7.0",
  "description": "Navegador leve (Electron) para PokeDream — abre ate 4 telas",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "check": "node --check main.js && node --check preload.js",
    "test": "node --test test/community.test.js test/diagnostics.test.js test/hunt-metrics.test.js test/hunt-hub.test.js",
    "dist": "electron-builder --win nsis --publish never",
    "release": "electron-builder --win nsis --publish always",
    "dist:linux": "electron-builder --linux AppImage --publish never"
  },
  "author": "",
  "license": "MIT",
  "dependencies": {
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.pokedream.launcher",
    "productName": "Poke Dream Launcher",
    "directories": {
      "output": "dist"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "marcos3777",
        "repo": "poke-dream-launcher",
        "releaseType": "release"
      }
    ],
    "files": [
      "main.js",
      "community.js",
      "hunt-metrics.js",
      "preload.js",
      "app.html",
      "config.html",
      "changelog.json",
      "sounds/**"
    ],
    "win": {
      "target": "nsis",
      "artifactName": "Poke-Dream-Launcher-Windows-${arch}.${ext}"
    },
    "linux": {
      "target": "AppImage",
      "category": "Utility",
      "artifactName": "Poke-Dream-Launcher-Linux-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Poke Dream Launcher"
    }
  }
}
